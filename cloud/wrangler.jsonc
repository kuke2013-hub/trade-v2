{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trade-v2-monitor",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "triggers": { "crons": ["*/3 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trade-v2-paper",
      "database_id": "c6907224-fad0-4e56-8a41-a477f5c23942"
    }
  ]
}